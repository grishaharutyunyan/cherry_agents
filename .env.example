# Google Cloud Platform & Vertex AI Credentials (Powered by $300 GCP Credits)
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
GEMINI_API_KEY=your-gemini-api-key-or-vertex-token

# Target Codebase Paths (relative to agents/ directory)
BACKEND_PATH=../game_backend
FRONTEND_PATH=../game-frontend

# Model Configuration
GEMINI_MODEL=gemini-3.6-flash
IMAGEN_MODEL=imagen-3.0-generate-002

# Telegram Delivery (Sends generated images & prompts directly to your Telegram)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_ADMIN_CHAT_ID=your-telegram-chat-id

# cherry_admin_backend — registers the generated game in gambling.games,
# refreshes game_service_backend's registry, and syncs the webapp.games
# catalog. Must match cherry_admin_backend's ADMIN_API_KEY env var exactly.
ADMIN_BACKEND_URL=http://localhost:7773
ADMIN_API_KEY=your-admin-api-key

# Job status/log store (POST /api/generate returns immediately with a jobId;
# GET /api/jobs/:id polls this). REDIS_URI can safely point at the same
# physical Redis instance cherry_backend/game_backend use — REDIS_DB puts
# job records on their own logical DB (not just a key prefix) so they never
# collide with round/session state or share a FLUSHDB blast radius with it.
REDIS_URI=redis://localhost:6379
REDIS_DB=1
