# ── Gemini auth: pick ONE of the two modes below ────────────────────────────
#
# Mode A — Developer API key (default, simplest). Leave GOOGLE_GENAI_USE_VERTEXAI
# unset/false. Billed against ai.google.dev usage, not GCP credits.
GEMINI_API_KEY=

# Mode B — Vertex AI (draws from GCP project billing/credits instead). Set
# GOOGLE_GENAI_USE_VERTEXAI=true and GOOGLE_CLOUD_PROJECT below; leave
# GEMINI_API_KEY blank — it's not used in this mode. Also requires GCP
# Application Default Credentials to actually be available to the process
# (GOOGLE_APPLICATION_CREDENTIALS pointing at a service account key file is
# the standard way for a server deployment — see README.md "Vertex AI mode").
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
# NOT an env var — the Vertex AI location is the "googleCloudLocation" row in the
# ai_agent_settings DB table (seeded to "global" by db/migrations/0003_settings.sql, editable
# in the admin panel). Every Gemini 3.x model is global/multi-region ONLY on Vertex AI — a
# regional location like us-central1 404s on every one of them, so this should stay "global"
# unless a future non-3.x model genuinely needs a specific region.

# Per-phase model selection (parse/design/build/qa) is NOT an env var — it's the
# ai_agent_model_config DB table (seeded by db/migrations/0002_model_config.sql), so it can
# change without a redeploy. See db/model-config.repo.ts.

# A database dedicated ONLY to ai_agent_runs / ai_agent_run_events — deliberately
# NOT the shared "cactus" app database cherry_backend/cherry_admin_backend use
# (cherry_admin_backend reaches this same database through its own separate
# "AgentsDatabase" connection — see its config.ts/app.module.ts).
#
# Run `npm run db:setup` once (needs PGHOST/PGPORT/PGUSER/PGPASSWORD for a Postgres
# superuser + CHERRY_AGENTS_DB_PASSWORD — see db/setup.sh) on this Postgres instance —
# it creates the `cherry_agents_app` role AND the `cherry_agents` database, owned by
# that role and nothing else. Same instance/server as the app DB is fine; it must
# be a genuinely separate `CREATE DATABASE`, not just a different schema/role.
DB_AGENTS_URI=postgresql://cherry_agents_app:change_me@localhost:5432/cherry_agents

# Local dev: point these at your existing sibling checkouts (defaults to
# <repo root>/game_backend and <repo root>/game-frontend if unset).
# Production: see README.md — these must be real working clones, not a bind-mounted
# monorepo (the root "cherry" repo has no git remote and prod deploys pre-built
# per-service images, not a shared host checkout).
MONOREPO_ROOT=
GAME_BACKEND_PATH=
GAME_FRONTEND_PATH=
CHERRY_FRONTEND_PATH=

POLL_INTERVAL_MS=10000
LOCK_TTL_SECONDS=120
MAX_TURNS_PER_PHASE=40

# ── Git / GitHub (M3 build commits, M5 push + PR automation) ───────────────
#
# GH_TOKEN is read automatically by the `gh` CLI (no `gh auth login` needed) and is also used,
# via docker-entrypoint.sh, as the git push credential over HTTPS (it rewrites this container's
# git@github.com: remotes to https://github.com/ and lets `gh auth setup-git` install itself as
# the credential helper) — so one PAT covers both `git push` and `gh pr create`. Generate a
# fine-grained PAT scoped to the game_backend and game-frontend repos only, with Contents
# (read/write) and Pull requests (read/write) permissions. Never paste the token itself anywhere
# in chat/logs — set it directly in the deploy target's env file.
GH_TOKEN=
GIT_AUTHOR_NAME=cherry-agents-bot
GIT_AUTHOR_EMAIL=cherry-agents-bot@users.noreply.github.com
