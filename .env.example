# Google Cloud Platform & Vertex AI Credentials (Powered by $300 GCP Credits)
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
GEMINI_API_KEY=your-gemini-api-key-or-vertex-token

# Target Codebase Paths (relative to agents/ directory)
BACKEND_PATH=../game_backend
FRONTEND_PATH=../game-frontend

# Model Configuration
GEMINI_MODEL=gemini-3.6-flash
IMAGEN_MODEL=imagen-3.0-generate-002

# Telegram Delivery (Sends generated images & prompts directly to your Telegram)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_ADMIN_CHAT_ID=your-telegram-chat-id
